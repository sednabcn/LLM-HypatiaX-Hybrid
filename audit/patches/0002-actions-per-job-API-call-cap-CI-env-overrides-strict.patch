@@ -0,0 +1,63 @@
+name: methods
+# rsc/methods: tests on every PR / agent branch (NO secrets), and an opt-in LIVE smoke (real LLM + real PySR + torch).
+# Real experiment runs are NOT in this file: they need scripts/run_hybrid_all.sh and ci_runner_hybrid.yml, which are not in the tree
+# this workflow was written against. See "Running in GitHub Actions" in rsc/methods/README.md for the sharding / budget rules.
+on:
+  pull_request:
+    paths: ["rsc/**", "config/**", "requirements.txt", ".github/workflows/methods.yml"]
+  push:
+    branches: ["agent/**"]
+    paths: ["rsc/**", "config/**", "requirements.txt", ".github/workflows/methods.yml"]
+  workflow_dispatch:
+    inputs:
+      live_smoke:
+        description: "Run the live smoke (spends API calls)"
+        type: boolean
+        default: false
+      max_calls:
+        description: "Hard cap on API calls for this job"
+        type: string
+        default: "40"
+
+permissions:
+  contents: read
+
+jobs:
+  tests:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.11", cache: pip}
+      - run: pip install -r requirements.txt
+      - run: make test
+
+  live-smoke:
+    # Manual only, after the tests pass, and gated by the `anthropic-live` environment (add required reviewers there):
+    # fork PRs and ordinary pushes can never reach the secret or spend money.
+    if: github.event_name == 'workflow_dispatch' && inputs.live_smoke
+    needs: tests
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    environment: anthropic-live
+    env:
+      HX_API_MODE: live                    # missing key = error, never a silent mock
+      HX_MAX_CALLS: ${{ inputs.max_calls }}
+      PYSR_POPULATIONS: "2"                # smoke budget from config/experiments.yml (200 generations)
+      PYSR_GENERATIONS: "200"
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.11", cache: pip}
+      - uses: julia-actions/setup-julia@v2
+        with: {version: "1.10"}
+      - run: pip install -r requirements.txt anthropic pysr
+      - run: pip install torch --index-url https://download.pytorch.org/whl/cpu
+      - name: strict live smoke (fails on mock LLM, substitute search, sklearn NN, or any variant error)
+        env:
+          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}   # only this step sees the key
+        run: python -m rsc.methods.smoke --strict | tee smoke.log
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with: {name: methods-smoke-log, path: smoke.log}
