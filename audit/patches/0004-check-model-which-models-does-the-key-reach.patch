diff --git a/rsc/experiments/tests/test_methods_check_model.py b/rsc/experiments/tests/test_methods_check_model.py
new file mode 100644
index 0000000..c0a1975
--- /dev/null
+++ b/rsc/experiments/tests/test_methods_check_model.py
@@ -0,0 +1,41 @@
+from types import SimpleNamespace
+from rsc.methods.check_model import check
+
+
+class _NotFound(Exception):
+    status_code = 404
+
+
+class _Client:
+    def __init__(self, known, no_temp=()):
+        self.known, self.no_temp, self.calls = set(known), set(no_temp), []
+        self.models = SimpleNamespace(retrieve=self._retrieve)
+        self.messages = SimpleNamespace(create=self._create)
+
+    def _retrieve(self, m):
+        if m not in self.known:
+            raise _NotFound("model not found")
+
+    def _create(self, model, temperature, **_):
+        self.calls.append((model, temperature))
+        if model not in self.known:
+            raise _NotFound("model not found")
+        if model in self.no_temp:
+            raise ValueError("temperature is not supported")
+        return SimpleNamespace(model=model)
+
+
+def test_reports_unknown_model_and_rejected_temperature():
+    c = _Client(known={"a", "b"}, no_temp={"b"})
+    rows = {(r["model"], r["temperature"]): r for r in check(c, ["a", "b", "zzz"], [0.0, 0.25])}
+    assert rows[("a", 0.0)]["ok"] and rows[("a", 0.25)]["ok"]
+    assert not rows[("b", 0.0)]["ok"] and "temperature" in rows[("b", 0.0)]["detail"]
+    assert not rows[("zzz", 0.0)]["ok"] and rows[("zzz", 0.0)]["listed"].startswith("no")
+    assert len(c.calls) == 6                              # one call per pair, nothing more
+
+
+def test_main_without_key_exits_2_and_never_prints_a_key(monkeypatch, capsys):
+    from rsc.methods.check_model import main
+    monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
+    assert main([]) == 2
+    assert "ANTHROPIC_API_KEY" in capsys.readouterr().out
