diff --git a/rsc/methods/check_model.py b/rsc/methods/check_model.py
new file mode 100644
index 0000000..a3bab80
--- /dev/null
+++ b/rsc/methods/check_model.py
@@ -0,0 +1,69 @@
+"""Decision 0.3 helper: which model ids does YOUR key reach, and do they accept the temperature the config asks for?
+
+    python -m rsc.methods.check_model                     # configured model at the configured temperature
+    python -m rsc.methods.check_model --model claude-sonnet-5-5 --model claude-sonnet-5 --temperature 0 --temperature 0.25
+
+Per (model, temperature) it makes ONE call with max_tokens=8, so the whole check costs a handful of tokens. Per model it also asks the
+models endpoint whether the id exists for this key. The key is read through config/api_env.yml (the variable name only), never printed.
+Exit code 0 only if every requested (model, temperature) pair worked; the table says what failed and why.
+"""
+from __future__ import annotations
+import argparse, sys
+from .env import ApiEnv, EnvError
+
+
+def _err(e: Exception) -> str:
+    code = getattr(e, "status_code", None)
+    msg = str(getattr(e, "message", None) or e).replace("\n", " ")[:160]
+    return f"{type(e).__name__}{f' {code}' if code else ''}: {msg}"
+
+
+def check(client, models, temps, max_tokens: int = 8) -> list[dict]:
+    rows = []
+    for m in models:
+        try:
+            client.models.retrieve(m)
+            listed = "yes"
+        except Exception as e:                                     # not-found vs. a models endpoint that is unavailable
+            listed = "no (" + _err(e) + ")" if getattr(e, "status_code", None) == 404 else "unknown (" + _err(e) + ")"
+        for t in temps:
+            row = {"model": m, "temperature": t, "listed": listed, "ok": False, "detail": ""}
+            try:
+                r = client.messages.create(model=m, max_tokens=max_tokens, temperature=t,
+                                           messages=[{"role": "user", "content": "Reply with the single word: ok"}])
+                row["ok"] = True
+                row["detail"] = f"served_by={getattr(r, 'model', '?')}"
+            except Exception as e:
+                row["detail"] = _err(e)
+            rows.append(row)
+    return rows
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--model", action="append", help="model id to test (repeatable); default: the model in config/api_env.yml")
+    ap.add_argument("--temperature", action="append", type=float, help="temperature to test (repeatable); default: the configured one")
+    a = ap.parse_args(argv)
+    try:
+        env = ApiEnv.load(); env.validate()
+    except EnvError as e:
+        print(f"config error: {e}"); return 2
+    key = env.api_key()
+    if not key:
+        print(f"no key: set the environment variable {env.api_key_env} (in Actions: the repository secret of that name)"); return 2
+    import anthropic
+    kw = {"api_key": key, "timeout": env.timeout_s, "max_retries": env.max_retries}
+    if env.base_url():
+        kw["base_url"] = env.base_url()
+    models = a.model or [env.model]
+    temps = a.temperature if a.temperature is not None else [env.temperature]
+    rows = check(anthropic.Anthropic(**kw), models, temps)
+    print(f"{'model':28s} {'T':>5s}  {'listed':8s} {'call':5s} detail")
+    for r in rows:
+        print(f"{r['model']:28s} {r['temperature']:>5}  {r['listed'][:8]:8s} {'OK' if r['ok'] else 'FAIL':5s} {r['detail']}")
+    print(f"\nconfig/api_env.yml currently says: model={env.model} temperature={env.temperature} strict_temperature={env.strict_temperature}")
+    return 0 if all(r["ok"] for r in rows) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
