diff --git a/.github/workflows/methods.yml b/.github/workflows/methods.yml
index d824b58..0d41593 100644
--- a/.github/workflows/methods.yml
+++ b/.github/workflows/methods.yml
@@ -14,6 +14,10 @@ on:
         description: "Run the live smoke (spends API calls)"
         type: boolean
         default: false
+      check_model:
+        description: "Decision 0.3: test which models your key reaches and whether they accept T=0 / T=0.25 (4-8 tiny calls)"
+        type: boolean
+        default: false
       max_calls:
         description: "Hard cap on API calls for this job"
         type: string
@@ -61,3 +65,18 @@ jobs:
       - uses: actions/upload-artifact@v4
         if: always()
         with: {name: methods-smoke-log, path: smoke.log}
+
+  check-model:
+    if: github.event_name == 'workflow_dispatch' && inputs.check_model
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    environment: anthropic-live
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.11", cache: pip}
+      - run: pip install -r requirements.txt anthropic
+      - name: model / temperature check (prints a table, never the key)
+        env:
+          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}   # only this step sees the key
+        run: make check-model
diff --git a/Makefile b/Makefile
index d419035..05c0405 100644
--- a/Makefile
+++ b/Makefile
@@ -1,9 +1,9 @@
 # One-command flows. `make dryrun` proves the plumbing on SYNTHETIC data; `make real` is the only path to paper numbers.
 PY ?= python3
 RESULTS ?= results
-.PHONY: cases test dryrun real paper paper-dryrun refs audit clean help methods-smoke
+.PHONY: cases test dryrun real paper paper-dryrun refs audit clean help methods-smoke check-model
 help:
-	@echo "make test | dryrun | real RESULTS=<dir> | refs | audit | methods-smoke | clean"
+	@echo "make test | dryrun | real RESULTS=<dir> | refs | audit | methods-smoke | check-model | clean"
 cases:                        ## validate case files (expected to fail until P1 has 30 verified cases)
 	$(PY) scripts/validate_cases.py
 test:
@@ -32,3 +32,5 @@ methods-smoke:                ## wiring check of rsc/methods on one synthetic ta
 	$(PY) -m rsc.methods.smoke
 clean:
 	cd paper && latexmk -C >/dev/null 2>&1; rm -rf _dryrun; rm -f rsc/db/results_dryrun.sqlite
+check-model:                  ## which models does my key reach? needs ANTHROPIC_API_KEY; ~8 tokens per (model, T) pair
+	$(PY) -m rsc.methods.check_model --model claude-sonnet-5-5 --model claude-sonnet-5 --temperature 0 --temperature 0.25
