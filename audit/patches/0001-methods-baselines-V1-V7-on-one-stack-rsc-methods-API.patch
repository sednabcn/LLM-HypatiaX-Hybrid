+++ b/rsc/methods/pysr.py
@@ -0,0 +1,27 @@
+"""PySR wrapper: guarded import, capability probe for `guesses` (V7 needs it; report s4.6 says V4 'seed' mode only
+works if the installed build exposes it -- silently ignoring it would repeat the use_llm dead-path bug)."""
+from __future__ import annotations
+import inspect, os
+
+def available() -> bool:
+    try:
+        import pysr  # noqa: F401
+        return True
+    except Exception:
+        return False
+
+def supports_guesses() -> bool:
+    if not available(): return False
+    from pysr import PySRRegressor
+    return "guesses" in inspect.signature(PySRRegressor.__init__).parameters
+
+def make_regressor(seed: int = 42, generations: int | None = None, guesses=None, **kw):
+    """Raise (never ignore) when guesses are requested but unsupported."""
+    if not available(): raise RuntimeError("PySR/Julia not installed: real experiments need them (config/installation.yml)")
+    from pysr import PySRRegressor
+    if guesses and not supports_guesses():
+        raise RuntimeError("installed PySR has no `guesses` argument: refusing to run 'seeded' as unseeded (audit A-020)")
+    args = dict(populations=int(os.environ.get("PYSR_POPULATIONS", 30)), niterations=int(generations or os.environ.get("PYSR_GENERATIONS", 10000)),
+                random_state=seed, deterministic=True, parallelism="serial", **kw)
+    if guesses: args["guesses"] = guesses
+    return PySRRegressor(**args)
diff --git a/rsc/methods/retrieval.py b/rsc/methods/retrieval.py
new file mode 100644
index 0000000..f50d181
--- /dev/null
+++ b/rsc/methods/retrieval.py
@@ -0,0 +1,90 @@
+"""Optional RAG for the LLM step: retrieve reference formula cards and put them in the prompt.
+
+Offline and dependency-free (TF-IDF + cosine) so a run is reproducible and costs no API calls.
+OFF by default everywhere: turning it on changes the experiment, so it must be a declared ablation.
+
+Leakage is the main risk of RAG in a benchmark (the knowledge base can contain the answer), so:
+  * view_for_case(case_id, gt_formula) returns a retriever with that case's card and any card whose
+    formula equals / contains the ground truth removed
+  * audit_prompt_leak(prompt, gt_formula) is a final check the harness can run on every prompt sent
+The Task object has no ground-truth field; the harness passes gt_formula to these two functions only.
+"""
+from __future__ import annotations
+import math, pathlib, re
+from dataclasses import dataclass
+from collections import Counter
+
+import yaml
+
+
+@dataclass(frozen=True)
+class Card:
+    id: str
+    name: str
+    domain: str
+    formula: str
+    variables: tuple
+    description: str
+    source: str = ""
+
+
+def normalize_formula(s: str) -> str:
+    s = re.sub(r"^\s*[A-Za-z_]\w*\s*=\s*", "", s or "")
+    return re.sub(r"\s+", "", s.replace("^", "**")).lower()
+
+
+def _tokens(text: str) -> list:
+    return re.findall(r"[a-z0-9_]+", (text or "").lower())
+
+
+def leaks(gt_formula: str, card: Card) -> bool:
+    g, c = normalize_formula(gt_formula), normalize_formula(card.formula)
+    return bool(g) and (g == c or (len(g) > 6 and g in c))
+
+
+def audit_prompt_leak(prompt: str, gt_formula: str) -> bool:
+    """True if the ground-truth formula text appears in the prompt (after normalisation)."""
+    g = normalize_formula(gt_formula)
+    return bool(g) and len(g) > 3 and g in re.sub(r"\s+", "", prompt.replace("^", "**")).lower()
+
+
+class Retriever:
+    def __init__(self, cards: list, k: int = 3):
+        self.cards, self.k = list(cards), k
+        docs = [Counter(_tokens(f"{c.name} {c.domain} {c.description} {' '.join(c.variables)}")) for c in self.cards]
+        n = len(docs)
+        df = Counter(t for d in docs for t in d)
+        self._idf = {t: math.log((n + 1) / (v + 1)) + 1.0 for t, v in df.items()}
+        self._vecs = [self._vec(d) for d in docs]
+
+    @classmethod
+    def from_yaml(cls, path, k: int = 3) -> "Retriever":
+        raw = yaml.safe_load(pathlib.Path(path).read_text()) or {}
+        cards = [Card(id=str(c["id"]), name=c["name"], domain=c.get("domain", ""), formula=c["formula"],
+                      variables=tuple(c.get("variables", [])), description=c.get("description", ""),
+                      source=c.get("source", "")) for c in raw.get("cards", [])]
+        return cls(cards, k=k)
+
+    def _vec(self, counts: Counter) -> dict:
+        v = {t: (1 + math.log(c)) * self._idf.get(t, 1.0) for t, c in counts.items()}
+        norm = math.sqrt(sum(x * x for x in v.values())) or 1.0
+        return {t: x / norm for t, x in v.items()}
+
+    def view_for_case(self, case_id: str | None = None, gt_formula: str | None = None) -> "Retriever":
+        keep = [c for c in self.cards
+                if not (case_id and c.id == case_id) and not (gt_formula and leaks(gt_formula, c))]
+        return Retriever(keep, k=self.k)
+
+    def retrieve(self, query: str, k: int | None = None) -> list:
+        q = self._vec(Counter(_tokens(query)))
+        scored = sorted(((sum(w * v.get(t, 0.0) for t, w in q.items()), c.id, c)
+                         for v, c in zip(self._vecs, self.cards)), key=lambda t: (-t[0], t[1]))
+        return [c for s, _, c in scored[: (k or self.k)] if s > 0]
+
+    def context(self, query: str, k: int | None = None) -> str:
+        cards = self.retrieve(query, k)
+        if not cards:
+            return ""
+        lines = [f"- {c.name} ({c.domain}): {c.formula}   [vars: {', '.join(c.variables)}]" for c in cards]
+        return ("Reference formulas from a knowledge base (may be irrelevant; use only if they truly apply):\n"
+                + "\n".join(lines))
diff --git a/rsc/methods/rows.py b/rsc/methods/rows.py
new file mode 100644
index 0000000..62c979b
--- /dev/null
+++ b/rsc/methods/rows.py
@@ -0,0 +1,60 @@
+"""FitResult -> one result row carrying what PLAYBOOK_ANCHOR rule 4 (comparability key) and the ingest guards need.
+
+Field names follow the repo docs (seed, engine_version, api_calls, wall_s, decision, r2_far, llm model + temperature,
+case-set hash, split, threshold, config hash). scripts/ingest_results.py is NOT in the zip this was built against:
+confirm the exact names against it before the first smoke run (PLAYBOOK 6.1).
+
+Rules enforced here, not left to the caller:
+  * r2_far is RECOMPUTED from the raw far-range predictions; the method's own train_r2 is stored separately.
+  * engine_version, case_set_hash, split and threshold have no defaults: a row cannot be made without them.
+  * a row produced with the mock/fixture LLM, the substitute search or the sklearn NN is marked synthetic=True
+    (with the reasons), so the ingest guard "synthetic rows refused" can see it. Nothing here ever claims a row is REAL;
+    only ingest does.
+"""
+from __future__ import annotations
+import hashlib, json
+
+from .common import FitResult, Task, r2, safe_predict
+
+# First alias of each id in the FROZEN config/variants.yml (the regexes ingest matches against `method`).
+METHOD_NAME = {"B_LLM": "PureLLM", "B_NN": "ImprovedNN", "B_PYSR": "pysr_none",
+               "V1": "EnhancedHybridDeFi", "V2": "HybridAllDomains", "V3": "EnsembleLLMNN",
+               "V4": "SymbolicEngine", "V5": "HybridSystemV50", "V6": "V4Selector", "V7": "LLMPriorSeeding"}
+
+
+def config_hash(stack, fit: FitResult) -> str:
+    blob = {"api_env": stack.env.public_dict(), "variant_params": fit.info.get("variant_params", {}),
+            "search_engine": stack.search.engine, "rag": stack.retriever is not None}
+    return hashlib.sha256(json.dumps(blob, sort_keys=True, default=str).encode()).hexdigest()[:16]
+
+
+def result_row(variant_id: str, task: Task, fit: FitResult, stack, *, X_far, y_far, engine_version: str,
+               case_set_hash: str, split: str, threshold: float, X_test=None, y_test=None) -> dict:
+    prov = stack.provenance()
+    llm = prov["llm"]
+    reasons = []
+    if llm.get("backend") != "live":
+        reasons.append(f"llm_backend={llm.get('backend')}")
+    if prov["search_engine"] != "pysr":
+        reasons.append(f"search_engine={prov['search_engine']}")
+    if prov["nn_backend"] != "torch":
+        reasons.append(f"nn_backend={prov['nn_backend']}")
+    cfg = config_hash(stack, fit)
+    row = {
+        "method_id": variant_id, "method": METHOD_NAME[variant_id.split("_")[0] if variant_id.startswith("V4_") else variant_id],
+        "case_id": task.case_id, "seed": task.seed, "split": split, "threshold": threshold,
+        "engine_version": engine_version, "case_set_hash": case_set_hash, "config_hash": cfg,
+        "llm_model": llm.get("model"), "temperature_requested": llm.get("temperature_requested"),
+        "temperature_used": llm.get("temperature_used"),
+        "decision": fit.decision, "equation": fit.equation,
+        "r2_far": r2(y_far, safe_predict(fit, X_far)),
+        "r2_test": r2(y_test, safe_predict(fit, X_test)) if X_test is not None else None,
+        "train_r2_reported": fit.train_r2, "selects_on": fit.info.get("selects_on"),
+        "api_calls": fit.api_calls, "search_calls": fit.search_calls, "wall_s": fit.info.get("seconds"),
+        "synthetic": bool(reasons), "synthetic_reasons": reasons,
+        "provenance": prov,
+    }
+    row["comparability_key"] = [case_set_hash, split, task.seed, threshold, engine_version,
+                                f"{row['llm_model']}@{row['temperature_requested']}", cfg]
+    row["info"] = {k: v for k, v in fit.info.items() if k != "variant_params"}
+    return row
diff --git a/rsc/methods/search.py b/rsc/methods/search.py
new file mode 100644
index 0000000..1799ef5
--- /dev/null
+++ b/rsc/methods/search.py
@@ -0,0 +1,117 @@
+"""Search engines behind one interface:  engine.run(X, y, names, seed, guesses, unary) -> SearchResult.
+
+PySRSearch      the real engine (needs `pip install pysr` + Julia). NOT executed in the authoring sandbox.
+SubstituteSearch greedy forward selection over a symbolic term library (numpy only). It is NOT PySR:
+                 numbers from it must never be compared with the paper. It exists so gate logic can be tested.
+
+`guesses` (equation strings) seed the search. The substitute adds each guess as one extra library column;
+PySR receives them through its `guesses` argument and refuses to run (pysr.make_regressor) if the installed
+build does not support it, rather than silently running unseeded.
+"""
+from __future__ import annotations
+import warnings
+from dataclasses import dataclass, field
+from typing import Callable
+
+import numpy as np
+
+from .common import predict_from_equation, equation_ok, r2
+
+DEFAULT_UNARY = ("sq", "sqrt", "log", "inv", "sin", "cos")
+
+
+@dataclass
+class SearchResult:
+    expression: str
+    r2: float
+    predict: Callable
+    engine: str
+    info: dict = field(default_factory=dict)
+
+
+def library_terms(names: list, unary) -> list:
+    t = list(names)
+    for n in names:
+        if "sq" in unary:   t.append(f"({n})**2")
+        if "sqrt" in unary: t.append(f"sqrt({n})")
+        if "log" in unary:  t.append(f"log({n})")
+        if "inv" in unary:  t.append(f"1/({n})")
+        if "sin" in unary:  t.append(f"sin({n})")
+        if "cos" in unary:  t.append(f"cos({n})")
+        if "exp" in unary:  t.append(f"exp({n})")
+    for i, a in enumerate(names):
+        for b in names[i + 1:]:
+            t.append(f"({a})*({b})")
+    return t
+
+
+class SubstituteSearch:
+    engine = "substitute_feature_library"
+    supports_guesses = True
+
+    def __init__(self, max_terms: int = 4):
+        self.max_terms = max_terms
+
+    def run(self, X, y, names, seed: int = 42, guesses=None, unary=DEFAULT_UNARY) -> SearchResult:
+        pool = library_terms(names, unary) + [g for g in (guesses or []) if equation_ok(g, names)]
+        cols, terms = [], []
+        for term in dict.fromkeys(pool):                      # de-duplicate, keep order
+            try:
+                v = predict_from_equation(term, X, names)
+            except Exception:
+                continue
+            if v.shape == (len(y),) and np.all(np.isfinite(v)) and np.std(v) > 1e-9:
+                cols.append(v); terms.append(term)
+        order = list(np.random.default_rng(seed).permutation(len(terms)))   # seed only breaks ties
+        M = np.column_stack(cols) if cols else np.zeros((len(y), 0))
+        selected: list = []
+        best_r2, coefs = -np.inf, np.array([float(np.mean(y))])
+        for _ in range(self.max_terms):
+            best_j, best_local, best_fit = None, best_r2, None
+            for j in order:
+                if j in selected:
+                    continue
+                A = np.column_stack([np.ones(len(y))] + [M[:, k] for k in selected + [j]])
+                with warnings.catch_warnings():
+                    warnings.simplefilter("ignore")
+                    c, *_ = np.linalg.lstsq(A, y, rcond=None)
+                s = r2(y, A @ c)
+                if s > best_local:
+                    best_local, best_j, best_fit = s, j, c
+            if best_j is None or best_local <= best_r2 + 1e-6:
+                break
+            selected.append(best_j); best_r2, coefs = best_local, best_fit
+        parts = [f"{float(c):.10g}*({terms[j]})" for c, j in zip(coefs[1:], selected)]
+        expr = " + ".join(parts + [f"{float(coefs[0]):.10g}"])
+        pred = predict_from_equation(expr, X, names)
+        return SearchResult(expr, r2(y, pred), lambda Xn, e=expr: predict_from_equation(e, Xn, names),
+                            self.engine, {"terms": [terms[j] for j in selected], "n_guesses": len(guesses or [])})
+
+
+class PySRSearch:
+    """Real PySR. Untested here (no Julia in the sandbox): run `python -m rsc.methods.smoke --search pysr` first."""
+    engine = "pysr"
+
+    def __init__(self, niterations: int | None = None, timeout_s: int | None = None):
+        self.niterations, self.timeout_s = niterations, timeout_s
+
+    @property
+    def supports_guesses(self) -> bool:
+        from . import pysr as P
+        return P.supports_guesses()
+
+    def run(self, X, y, names, seed: int = 42, guesses=None, unary=DEFAULT_UNARY) -> SearchResult:
+        from . import pysr as P
+        kw: dict = dict(binary_operators=["+", "-", "*", "/"])
+        ops = [u for u in unary if u in ("sin", "cos", "exp", "log", "sqrt")]
+        if "inv" in unary:
+            ops.append("inv(x) = 1/x"); kw["extra_sympy_mappings"] = {"inv": lambda x: 1 / x}
+        if ops:
+            kw["unary_operators"] = ops
+        if self.timeout_s:
+            kw["timeout_in_seconds"] = self.timeout_s
+        model = P.make_regressor(seed=seed, generations=self.niterations, guesses=guesses or None, **kw)
+        model.fit(X, y, variable_names=list(names))
+        pred = np.asarray(model.predict(X), float)
+        return SearchResult(str(model.sympy()), r2(y, pred), lambda Xn: np.asarray(model.predict(Xn), float),
+                            self.engine, {"n_guesses": len(guesses or [])})
diff --git a/rsc/methods/smoke.py b/rsc/methods/smoke.py
new file mode 100644
index 0000000..155d725
--- /dev/null
+++ b/rsc/methods/smoke.py
@@ -0,0 +1,46 @@
+"""Smoke run: every variant on one synthetic, extrapolative task.   python -m rsc.methods.smoke [--search auto|pysr|substitute]
+
+With no API key this uses the scripted fixture LLM and (without PySR) the substitute search. The numbers it prints
+verify WIRING ONLY. They are not results and must never be compared with the paper.
+"""
+from __future__ import annotations
+import argparse
+import numpy as np
+
+from .common import Task, r2, safe_predict
+from .env import ApiEnv
+from .llm import FixtureLLM
+from .stack import build_stack
+from .variants import REGISTRY, make
+
+
+def synthetic_task(seed: int = 42, n: int = 120):
+    rng = np.random.default_rng(seed)
+    f = lambda X: 2.0 * X[:, 0] + 0.5 * X[:, 1] ** 2
+    Xtr = rng.uniform(1, 5, (n, 2)); Xfar = rng.uniform(5, 9, (40, 2))
+    task = Task(Xtr, f(Xtr) + rng.normal(0, 0.05, n), ["a", "b"], "linear in a plus half of b squared",
+                domain="synthetic", seed=seed, case_id="synthetic", X_test_features=Xfar)
+    return task, Xfar, f(Xfar)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--search", default="auto", choices=["auto", "pysr", "substitute"])
+    ap.add_argument("--live", action="store_true", help="use the LLM from config/api_env.yml instead of fixtures")
+    a = ap.parse_args()
+    env = ApiEnv.load()
+    llm = None if a.live else FixtureLLM({"default": [{"equation": "2*a + 0.4*b**2", "confidence": 0.7, "reasoning": "fixture"}]})
+    stack = build_stack(env, search=a.search, llm=llm)
+    task, Xf, yf = synthetic_task()
+    print(f"llm={stack.llm.backend} search={stack.search.engine} nn={stack.provenance()['nn_backend']}  (WIRING CHECK, not results)")
+    print(f"{'variant':12s} {'decision':24s} {'train_r2':>9s} {'far_r2':>9s} {'llm':>4s} {'srch':>4s}")
+    for vid in REGISTRY:
+        try:
+            r = make(vid).run(task, stack)
+            print(f"{vid:12s} {r.decision:24s} {r.train_r2:9.4f} {r2(yf, safe_predict(r, Xf)):9.4f} {r.api_calls:4d} {r.search_calls:4d}")
+        except Exception as e:
+            print(f"{vid:12s} ERROR {type(e).__name__}: {e}")
+
+
+if __name__ == "__main__":
+    main()
